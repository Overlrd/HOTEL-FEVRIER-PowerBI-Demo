	partition CollectionFollowUpTable = m
		mode: import
		source =
				let
				    Files = SharePoint.Files("https://ivorygoldconsulting-my.sharepoint.com/personal/augustin_kpadonou_ivorygoldglobal_com", [ApiVersion = 15]),
				    Source = Excel.Workbook(Files{[Name="Hotel_2_Fevrier_Donnees_Demo_PowerBI.xlsx"]}[Content], null, true),
				    InvoiceSource = Source{[Item="InvoiceTable",Kind="Table"]}[Data],
				    FollowUpSource = Source{[Item="SuiviRecouvrement",Kind="Table"]}[Data],
				    InvoiceTypes = Table.TransformColumnTypes(InvoiceSource,{{"Facture_ID", type text}, {"Type_Facture", type text}, {"Nom_Partenaire", type text}, {"Date_Facture", type date}, {"Date_Échéance", type date}, {"Montant_TTC", Int64.Type}, {"Montant_Payé", Int64.Type}, {"Solde", Int64.Type}, {"Statut_Paiement", type text}, {"Retard_Jours", Int64.Type}, {"Tranche_Retard", type text}}),
				    FollowUpTypes = Table.TransformColumnTypes(FollowUpSource,{{"Facture_ID", type text}, {"Responsable", type text}, {"Statut_Relance", type text}, {"Date_Dernière_Relance", type date}, {"Date_Prochaine_Action", type date}, {"Date_Promesse", type date}, {"Montant_Promis", Int64.Type}, {"Commentaire", type text}, {"Lien_Document", type text}}),
				    Merged = Table.NestedJoin(FollowUpTypes, {"Facture_ID"}, InvoiceTypes, {"Facture_ID"}, "Facture", JoinKind.Inner),
				    Expanded = Table.ExpandTableColumn(Merged, "Facture", {"Type_Facture", "Nom_Partenaire", "Date_Facture", "Date_Échéance", "Montant_TTC", "Montant_Payé", "Solde", "Statut_Paiement", "Retard_Jours", "Tranche_Retard"}, {"Type_Facture", "Nom_Partenaire", "Date_Facture", "Date_Échéance", "Montant_TTC", "Montant_Payé", "Solde", "Statut_Paiement", "Retard_Jours", "Tranche_Retard"}),
				    OpenClients = Table.SelectRows(Expanded, each [Type_Facture] = "Client" and [Solde] > 0),
				    AddAging = Table.AddColumn(OpenClients, "Tranche_Retard_Normalisée", each if [Retard_Jours] <= 0 then "Non échues" else if [Retard_Jours] <= 30 then "0–30 jours" else if [Retard_Jours] <= 60 then "31–60 jours" else if [Retard_Jours] <= 90 then "61–90 jours" else "Plus de 90 jours", type text),
				    AddAgingSort = Table.AddColumn(AddAging, "Tranche_Retard_Tri", each if [Retard_Jours] <= 0 then 0 else if [Retard_Jours] <= 30 then 1 else if [Retard_Jours] <= 60 then 2 else if [Retard_Jours] <= 90 then 3 else 4, Int64.Type),
				    AddPriority = Table.AddColumn(AddAgingSort, "Priorité_Recouvrement", each if [Retard_Jours] > 90 or [Solde] >= 20000000 then "Critique" else if [Retard_Jours] > 60 or [Solde] >= 10000000 then "Élevée" else if [Retard_Jours] > 30 or [Solde] >= 5000000 then "Moyenne" else "Normale", type text),
				    AddPrioritySort = Table.AddColumn(AddPriority, "Priorité_Tri", each if [Priorité_Recouvrement] = "Critique" then 4 else if [Priorité_Recouvrement] = "Élevée" then 3 else if [Priorité_Recouvrement] = "Moyenne" then 2 else 1, Int64.Type),
				    Selected = Table.SelectColumns(AddPrioritySort,{"Facture_ID", "Responsable", "Statut_Relance", "Date_Dernière_Relance", "Date_Prochaine_Action", "Date_Promesse", "Montant_Promis", "Commentaire", "Lien_Document", "Nom_Partenaire", "Date_Facture", "Date_Échéance", "Montant_TTC", "Montant_Payé", "Solde", "Statut_Paiement", "Retard_Jours", "Tranche_Retard", "Tranche_Retard_Normalisée", "Tranche_Retard_Tri", "Priorité_Recouvrement", "Priorité_Tri"})
				in
				    Selected

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table
