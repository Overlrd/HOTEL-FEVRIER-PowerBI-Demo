table CollectionFollowUpTable
	lineageTag: eb8da0c9-5ae3-4599-b8b0-f5f875fc9c8c

	measure 'Créances suivies' = SUM(CollectionFollowUpTable[Solde])
		formatString: 0
		lineageTag: ce3ffdee-5dfe-43d0-bb3d-dd9e4ab35706

	measure 'Créances suivies affichées' =
			VAR Montant = [Créances suivies]
			VAR ValeurAbsolue = ABS(Montant)
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(Montant), "0 XOF",
			    ValeurAbsolue >= 1000000000, FORMAT(DIVIDE(Montant, 1000000000), "0.00", "fr-FR") & " Md XOF",
			    ValeurAbsolue >= 1000000, FORMAT(DIVIDE(Montant, 1000000), "0.0", "fr-FR") & " M XOF",
			    FORMAT(Montant, "#,0", "fr-FR") & " XOF"
			)
		lineageTag: aed32dab-d9d4-4e7c-9939-55d42d2f7745

	measure 'Créances échues suivies' =
			CALCULATE(
			    [Créances suivies],
			    CollectionFollowUpTable[Retard_Jours] > 0
			)
		formatString: 0
		lineageTag: 9642b6e6-7086-4d2b-a3d1-796f2068a446

	measure 'Taux de créances échues' = DIVIDE([Créances échues suivies], [Créances suivies])
		formatString: 0.0%
		lineageTag: d75d4749-a97d-4428-af2f-ecadd025d55c

	measure 'Taux de créances échues affiché' =
			VAR Taux = [Taux de créances échues]
			RETURN IF(ISBLANK(Taux), "0,0 %", FORMAT(Taux, "0.0 %", "fr-FR"))
		lineageTag: fd96a58f-fb80-416f-aef4-5b9976a64ec9

	measure 'Encaissements attendus à 30 jours' =
			VAR DateFin = MAX(DateTable[Date])
			RETURN
			CALCULATE(
			    [Créances suivies],
			    CollectionFollowUpTable[Date_Échéance] >= DateFin,
			    CollectionFollowUpTable[Date_Échéance] <= DateFin + 30
			)
		formatString: 0
		lineageTag: ce937bd9-5f76-4e1a-b6a4-2a05c90ab2fc

	measure 'Encaissements attendus à 30 jours affichés' =
			VAR Montant = [Encaissements attendus à 30 jours]
			VAR ValeurAbsolue = ABS(Montant)
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(Montant), "0 XOF",
			    ValeurAbsolue >= 1000000000, FORMAT(DIVIDE(Montant, 1000000000), "0.00", "fr-FR") & " Md XOF",
			    ValeurAbsolue >= 1000000, FORMAT(DIVIDE(Montant, 1000000), "0.0", "fr-FR") & " M XOF",
			    FORMAT(Montant, "#,0", "fr-FR") & " XOF"
			)
		lineageTag: 22187991-018f-4225-a297-d1592ed0de15

	measure 'Promesses attendues à 30 jours' =
			VAR DateFin = MAX(DateTable[Date])
			RETURN
			CALCULATE(
			    SUM(CollectionFollowUpTable[Montant_Promis]),
			    CollectionFollowUpTable[Date_Promesse] >= DateFin,
			    CollectionFollowUpTable[Date_Promesse] <= DateFin + 30
			)
		formatString: 0
		lineageTag: 17b8e584-98a1-4162-990b-f0b5b4c3f869

	measure 'Promesses attendues à 30 jours affichées' =
			VAR Montant = [Promesses attendues à 30 jours]
			VAR ValeurAbsolue = ABS(Montant)
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(Montant), "0 XOF",
			    ValeurAbsolue >= 1000000000, FORMAT(DIVIDE(Montant, 1000000000), "0.00", "fr-FR") & " Md XOF",
			    ValeurAbsolue >= 1000000, FORMAT(DIVIDE(Montant, 1000000), "0.0", "fr-FR") & " M XOF",
			    FORMAT(Montant, "#,0", "fr-FR") & " XOF"
			)
		lineageTag: cefb39de-7869-44ce-9bf8-c34b2fd4ce85

	measure 'Nombre de factures suivies' = DISTINCTCOUNT(CollectionFollowUpTable[Facture_ID])
		formatString: 0
		lineageTag: 8abe82cc-14d5-4faa-8ae7-ed193b0ecd1d

	measure 'Plus ancien retard' = MAX(CollectionFollowUpTable[Retard_Jours])
		formatString: 0
		lineageTag: fc31a087-64d1-428d-a1e1-70291b21747b

	measure 'Plus ancien retard affiché' = FORMAT([Plus ancien retard], "#,0", "fr-FR") & " jours"
		lineageTag: cdff5d07-4aa8-48d2-9110-4e1212b6ffe9

	measure 'Client principal des créances' =
			VAR Clients =
			    TOPN(
			        1,
			        SUMMARIZE(
			            CollectionFollowUpTable,
			            CollectionFollowUpTable[Nom_Partenaire],
			            "Montant", [Créances suivies]
			        ),
			        [Montant], DESC,
			        CollectionFollowUpTable[Nom_Partenaire], ASC
			    )
			RETURN MAXX(Clients, CollectionFollowUpTable[Nom_Partenaire])
		lineageTag: a2a1a46e-0eb6-4979-9c13-f03c9c1707d4

	measure 'Facture sélectionnée' = SELECTEDVALUE(CollectionFollowUpTable[Facture_ID], "Sélection multiple")
		lineageTag: f3ae5957-91f9-42a0-800f-b1cca7f4f5d1

	measure 'Client sélectionné' = SELECTEDVALUE(CollectionFollowUpTable[Nom_Partenaire], "Sélection multiple")
		lineageTag: 472db8db-c2f2-4a9b-ac0d-a0afe0ba1dda

	measure 'Solde facture affiché' =
			VAR Montant = SELECTEDVALUE(CollectionFollowUpTable[Solde])
			RETURN IF(ISBLANK(Montant), BLANK(), FORMAT(Montant, "#,0", "fr-FR") & " XOF")
		lineageTag: ae8fa29c-0628-4b69-944e-29063d29b44d

	measure 'Retard facture affiché' =
			VAR Jours = SELECTEDVALUE(CollectionFollowUpTable[Retard_Jours])
			RETURN IF(ISBLANK(Jours), BLANK(), FORMAT(Jours, "#,0", "fr-FR") & " jours")
		lineageTag: e769668c-03af-4ad9-8923-704b2629f712

	measure 'Statut relance sélectionné' = SELECTEDVALUE(CollectionFollowUpTable[Statut_Relance], "Sélection multiple")
		lineageTag: 74b312e1-28a1-431a-8d42-d5d1f67ad89a

