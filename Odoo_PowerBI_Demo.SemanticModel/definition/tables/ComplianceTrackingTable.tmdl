		dataType: string
		lineageTag: 57d82ddd-3b63-4ff2-8bf6-601a9d6cec25
		summarizeBy: none
		sourceColumn: Référence_Paiement

	column Statut_Saisi
		dataType: string
		lineageTag: 0228f108-c464-4372-b94d-666e8b491be8
		summarizeBy: none
		sourceColumn: Statut_Saisi

	column Commentaire
		dataType: string
		lineageTag: 039f2080-22a0-451c-820c-8f1e0306a438
		summarizeBy: none
		sourceColumn: Commentaire

	column Contrôle_Obligation
		dataType: string
		lineageTag: 5c7abf79-6f28-4795-b7bf-b748bc8eca04
		summarizeBy: none
		sourceColumn: Contrôle_Obligation

	column 'Statut opérationnel' =
			VAR StatutSaisi = TRIM(COALESCE(ComplianceTrackingTable[Statut_Saisi], ""))
			VAR DateRéférence = ComplianceTrackingTable[Date_Référence]
			VAR DateÉchéance = ComplianceTrackingTable[Date_Échéance]
			VAR DateDéclaration = ComplianceTrackingTable[Date_Déclaration]
			VAR DatePaiement = ComplianceTrackingTable[Date_Paiement]
			VAR MontantDû = COALESCE(ComplianceTrackingTable[Montant_Dû], 0)
			VAR MontantPayé = COALESCE(ComplianceTrackingTable[Montant_Payé], 0)
			VAR Applicabilité = RELATED(ComplianceObligationTable[Applicabilité])
			VAR ÉcartComptable = SUMX(RELATEDTABLE(ComplianceReconciliationTable), ABS(COALESCE(ComplianceReconciliationTable[Écart_Comptabilité], 0)))
			VAR Jours = IF(NOT ISBLANK(DateÉchéance) && NOT ISBLANK(DateRéférence), DATEDIFF(DateRéférence, DateÉchéance, DAY))
			RETURN
			    SWITCH(
			        TRUE(),
			        StatutSaisi = "À confirmer" || Applicabilité = "À confirmer", "À confirmer",
			        ISBLANK(DateÉchéance) || ISBLANK(DateRéférence), "À confirmer",
			        ÉcartComptable > 0, "Écart à justifier",
			        StatutSaisi = "Clôturé" && ((NOT ISBLANK(DateDéclaration) && DateDéclaration > DateÉchéance) || (NOT ISBLANK(DatePaiement) && DatePaiement > DateÉchéance)), "Fait hors délai",
			        StatutSaisi = "Clôturé", "À jour",
			        DateÉchéance < DateRéférence && NOT ISBLANK(DateDéclaration) && MontantDû > MontantPayé, "Paiement en attente",
			        DateÉchéance < DateRéférence, "En retard",
			        Jours <= 7, "Urgent",
			        Jours <= 30, "À faire bientôt",
			        "À préparer"
			    )
		dataType: string
		lineageTag: f42ee752-5a81-46c7-8a35-c12bb475aa0f
		summarizeBy: none

	column Jours_Restants = IF(ISBLANK(ComplianceTrackingTable[Date_Échéance]) || ISBLANK(ComplianceTrackingTable[Date_Référence]), BLANK(), DATEDIFF(ComplianceTrackingTable[Date_Référence], ComplianceTrackingTable[Date_Échéance], DAY))
		dataType: int64
		formatString: 0
		lineageTag: 3bd7758b-84be-4293-bc2a-94687d076678
		summarizeBy: none

	column Écart_Paiement = MAX(0, COALESCE(ComplianceTrackingTable[Montant_Dû], 0) - COALESCE(ComplianceTrackingTable[Montant_Payé], 0))
		dataType: int64
		formatString: #,0
		lineageTag: aecff65d-832a-4228-ad5e-0422d444fa56
		summarizeBy: sum

	column 'État pièce' =
			VAR PreuveRequise = RELATED(ComplianceObligationTable[Preuve_Requise])
			VAR Pièces = RELATEDTABLE(ComplianceReconciliationTable)
			VAR NombrePièces = COUNTROWS(Pièces)
			VAR Disponibles = COUNTROWS(FILTER(Pièces, ComplianceReconciliationTable[Statut_Preuve] = "Disponible"))
			VAR ÀCompléter = COUNTROWS(FILTER(Pièces, ComplianceReconciliationTable[Statut_Preuve] IN {"Manquant", "À obtenir"}))
			RETURN
			    SWITCH(
			        TRUE(),
			        PreuveRequise = FALSE(), "Non requise",
			        NombrePièces = 0, "À confirmer",
			        Disponibles = NombrePièces, "Disponible",
			        ÀCompléter > 0, "À compléter",
			        "À confirmer"
			    )
		dataType: string
		lineageTag: 2e827960-b312-4b2a-86fb-28da66c76500
		summarizeBy: none

	column 'Action requise' =
			VAR Statut = ComplianceTrackingTable[Statut opérationnel]
			VAR ÉtatPièce = ComplianceTrackingTable[État pièce]
			RETURN
			    SWITCH(
			        TRUE(),
			        Statut = "En retard", "Régulariser l'échéance",
			        Statut = "Paiement en attente", "Effectuer le paiement",
			        Statut = "Écart à justifier", "Expliquer l'écart comptable",
			        Statut = "Urgent", "Finaliser le dossier",
			        Statut = "À faire bientôt", "Préparer le dossier",
			        Statut = "À confirmer", "Confirmer l'applicabilité",
			        ÉtatPièce = "À compléter", "Joindre le justificatif",
			        Statut = "À préparer", "Aucune action immédiate",
			        Statut = "Fait hors délai", "Archivé — hors délai",
			        "Dossier à jour"
			    )
		dataType: string
		lineageTag: d94647bd-123b-4945-a54a-78fb8fcc5afd
		summarizeBy: none

	column Priorité_Affichage =
			SWITCH(
			    ComplianceTrackingTable[Statut opérationnel],
			    "En retard", 1,
			    "Paiement en attente", 2,
			    "Écart à justifier", 3,
			    "Urgent", 4,
			    "À faire bientôt", 5,
			    "À confirmer", 6,
			    "À préparer", 7,
			    "Fait hors délai", 8,
			    9
			)
		dataType: int64
		formatString: 0
		lineageTag: 97faa598-6bd2-49ee-9f99-0c17843d4803
		summarizeBy: none

