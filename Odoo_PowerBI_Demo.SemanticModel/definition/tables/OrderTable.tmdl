table OrderTable
	lineageTag: 150139d1-7e83-4a58-9c36-c2cf014a3ba2

	measure 'Chiffre d''affaires' =
			
			CALCULATE(
			    SUM(OrderTable[Montant_TTC]),
			    OrderTable[Type_Commande] = "Vente",
			    OrderTable[Statut] = "Terminée"
			)
		formatString: 0
		lineageTag: b08b3791-f3d0-4348-bf5f-08471b2cd259

	measure 'CA Hébergement' =
			COALESCE(
			    CALCULATE(
			        [Chiffre d'affaires],
			        FILTER(
			            VALUES(OrderTable[Catégorie]),
			            VAR Categorie = UPPER(COALESCE(OrderTable[Catégorie], ""))
			            RETURN CONTAINSSTRING(Categorie, "HÉBERGEMENT") || CONTAINSSTRING(Categorie, "HEBERGEMENT")
			        )
			    ),
			    0
			)
		formatString: 0
		lineageTag: 9f4d9b60-c9ec-4c72-88d4-3044134b9db8

	measure 'CA Restaurant' =
			COALESCE(
			    CALCULATE(
			        [Chiffre d'affaires],
			        FILTER(
			            VALUES(OrderTable[Catégorie]),
			            CONTAINSSTRING(UPPER(COALESCE(OrderTable[Catégorie], "")), "RESTAUR")
			        )
			    ),
			    0
			)
		formatString: 0
		lineageTag: a5fa32ae-a3a0-4d97-b017-4fb1b1c91d22

	measure 'CA Bar' =
			COALESCE(
			    CALCULATE(
			        [Chiffre d'affaires],
			        FILTER(
			            VALUES(OrderTable[Catégorie]),
			            CONTAINSSTRING(UPPER(COALESCE(OrderTable[Catégorie], "")), "BAR")
			        )
			    ),
			    0
			)
		formatString: 0
		lineageTag: 8f6cc89e-c230-412c-b3d4-550659f42f3a

	measure 'CA Autres' =
			COALESCE([Chiffre d'affaires] - [CA Hébergement] - [CA Restaurant] - [CA Bar], 0)
		formatString: 0
		lineageTag: e8a8d515-4ad3-46c7-8380-cb7970da2d6c

	measure Achats =
			
			CALCULATE(
			    SUM(OrderTable[Montant_TTC]),
			    OrderTable[Type_Commande] = "Achat",
			    OrderTable[Statut] = "Terminée"
			)
		formatString: 0
		lineageTag: 3d1274f5-3699-476f-8737-ba10c84cfe07

	measure 'Chiffre d''affaires affiché' =
			VAR Montant = [Chiffre d'affaires]
			VAR ValeurAbsolue = ABS(Montant)
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(Montant), BLANK(),
			    ValeurAbsolue >= 1000000000, FORMAT(DIVIDE(Montant, 1000000000), "0.00", "fr-FR") & " Md XOF",
			    ValeurAbsolue >= 1000000, FORMAT(DIVIDE(Montant, 1000000), "0.0", "fr-FR") & " M XOF",
			    FORMAT(Montant, "#,0", "fr-FR") & " XOF"
			)
		lineageTag: b57c22b0-b9a4-46da-87e4-6f78eaaef240

	measure 'Évolution CA dernier mois' =
			VAR DateFin = MAX(DateTable[Date])
			VAR DateDebut = DATE(YEAR(DateFin), MONTH(DateFin), 1)
			VAR DateFinPrecedente = EDATE(DateFin, -1)
			VAR DateDebutPrecedente = DATE(YEAR(DateFinPrecedente), MONTH(DateFinPrecedente), 1)
			VAR Actuel = CALCULATE([Chiffre d'affaires], REMOVEFILTERS(DateTable), DATESBETWEEN(DateTable[Date], DateDebut, DateFin))
			VAR Precedent = CALCULATE([Chiffre d'affaires], REMOVEFILTERS(DateTable), DATESBETWEEN(DateTable[Date], DateDebutPrecedente, DateFinPrecedente))
			RETURN IF(ISBLANK(Precedent) || Precedent = 0, BLANK(), DIVIDE(Actuel - Precedent, ABS(Precedent)))
		formatString: 0.0%
		lineageTag: 69c9ce6a-d609-4ff3-9442-1190bed5790f

	measure 'Évolution CA affichée' =
			VAR Evolution = [Évolution CA dernier mois]
			RETURN IF(ISBLANK(Evolution), "Comparaison indisponible", IF(Evolution >= 0, "▲ ", "▼ ") & FORMAT(ABS(Evolution), "0.0 %", "fr-FR") & " vs mois préc.")
		lineageTag: 6ee2b64c-aa4d-4ce7-9880-9432fe0f7fd3

	measure 'Couleur évolution CA' =
			VAR Evolution = [Évolution CA dernier mois]
			RETURN SWITCH(TRUE(), ISBLANK(Evolution), "#667085", Evolution >= 0, "#2FA79B", "#EB5757")
		lineageTag: 0d71d16c-a82e-45ff-8829-26ad23c1dc23

