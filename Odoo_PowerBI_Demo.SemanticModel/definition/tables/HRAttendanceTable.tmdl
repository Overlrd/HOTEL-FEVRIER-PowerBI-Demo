	column Jours_Absents_Mois
		dataType: int64
		formatString: 0
		lineageTag: 321b8008-62d8-4f4a-9b5e-025973d51f92
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Jours_Absents_Mois]

	partition HRAttendanceTable = calculated
		mode: import
		source =
				VAR MaxSourceDate = CALCULATE(MAX(DateTable[Date]), ALL(DateTable))
				VAR BasePaie =
					SELECTCOLUMNS(
						FILTER(PayrollTable, PayrollTable[Mois] <= MaxSourceDate),
						"__Mois", PayrollTable[Mois],
						"__EmployeID", PayrollTable[Employé_ID],
						"__Nom", PayrollTable[Nom_Employé],
						"__Departement", PayrollTable[Département],
						"__JoursOuvres", PayrollTable[Jours_Ouvrés],
						"__JoursPresents", PayrollTable[Jours_Présents],
						"__JoursAbsents", PayrollTable[Jours_Absents],
						"__HeuresSup", PayrollTable[Heures_Sup]
					)
				RETURN
				GENERATE(
					BasePaie,
					VAR MoisRef = [__Mois]
					VAR EmployeID = [__EmployeID]
					VAR NomEmploye = [__Nom]
					VAR Departement = [__Departement]
					VAR JoursOuvres = MAX(1, [__JoursOuvres])
					VAR JoursPresents = MAX(0, MIN([__JoursPresents], JoursOuvres))
					VAR JoursAbsents = MAX(0, [__JoursAbsents])
					VAR HeuresSup = MAX(0, [__HeuresSup])
					VAR FinMois = MIN(EOMONTH(MoisRef, 0), MaxSourceDate)
					VAR JoursDisponibles = MAX(1, DAY(FinMois))
					VAR Seed = VALUE(RIGHT(EmployeID, 3))
					VAR Slots0 = GENERATESERIES(1, JoursOuvres, 1)
					VAR Slots1 =
						ADDCOLUMNS(
							Slots0,
							"__IndicePresence", MOD([Value] + Seed - 2, JoursOuvres) + 1,
							"__DateCalc", MoisRef + ROUNDUP(DIVIDE([Value] * JoursDisponibles, JoursOuvres), 0) - 1
						)
					VAR Slots2 =
						ADDCOLUMNS(
							Slots1,
							"__EstPresent", [__IndicePresence] <= JoursPresents,
							"__NonPlan", [__IndicePresence] > JoursPresents && MOD([__IndicePresence] + Seed, 3) <> 0,
							"__HeuresJour",
								IF(
									[__IndicePresence] <= JoursPresents,
									QUOTIENT(HeuresSup, MAX(1, JoursPresents))
										+ IF([__IndicePresence] <= MOD(HeuresSup, MAX(1, JoursPresents)), 1, 0),
									0
								)
						)
					RETURN
					SELECTCOLUMNS(
						Slots2,
						"Date", [__DateCalc],
						"Date_Clé", FORMAT([__DateCalc], "yyyymmdd"),
						"Employé_ID", EmployeID,
						"Nom_Employé", NomEmploye,
						"Département", Departement,
						"Statut", IF([__EstPresent], "Présent", IF([__NonPlan], "Absent", "Congé")),
						"Non_Planifiée", [__NonPlan],
						"Heures_Sup_Jour", [__HeuresJour],
						"Heures_Sup_Mois", HeuresSup,
						"Jours_Absents_Mois", JoursAbsents
					)
				)
