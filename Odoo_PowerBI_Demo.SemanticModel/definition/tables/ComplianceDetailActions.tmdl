		sourceColumn: [Suivi_ID]

	column 'Organisme'
		dataType: string
		lineageTag: 20222222-2222-4222-8222-222222222002
		summarizeBy: none
		isNameInferred
		sourceColumn: [Organisme]

	column 'Obligation'
		dataType: string
		lineageTag: 20222222-2222-4222-8222-222222222003
		summarizeBy: none
		isNameInferred
		sourceColumn: [Obligation]

	column 'Statut'
		dataType: string
		lineageTag: 20222222-2222-4222-8222-222222222004
		summarizeBy: none
		isNameInferred
		sourceColumn: [Statut]

	column 'Échéance'
		dataType: dateTime
		formatString: Short Date
		lineageTag: 20222222-2222-4222-8222-222222222005
		summarizeBy: none
		isNameInferred
		sourceColumn: [Échéance]

	column 'Jours restants'
		dataType: int64
		formatString: 0
		lineageTag: 20222222-2222-4222-8222-222222222006
		summarizeBy: none
		isNameInferred
		sourceColumn: [Jours restants]

	column 'Action'
		dataType: string
		lineageTag: 20222222-2222-4222-8222-222222222007
		summarizeBy: none
		isNameInferred
		sourceColumn: [Action]

	column 'Responsable'
		dataType: string
		lineageTag: 20222222-2222-4222-8222-222222222008
		summarizeBy: none
		isNameInferred
		sourceColumn: [Responsable]

	column 'Montant dû'
		dataType: int64
		formatString: #,0
		lineageTag: 20222222-2222-4222-8222-222222222009
		summarizeBy: none
		isNameInferred
		sourceColumn: [Montant dû]

	column 'Montant payé'
		dataType: int64
		formatString: #,0
		lineageTag: 20222222-2222-4222-8222-222222222010
		summarizeBy: none
		isNameInferred
		sourceColumn: [Montant payé]

	column 'Reste à payer'
		dataType: int64
		formatString: #,0
		lineageTag: 20222222-2222-4222-8222-222222222011
		summarizeBy: none
		isNameInferred
		sourceColumn: [Reste à payer]

	partition ComplianceDetailActions = calculated
		mode: import
		source =
				SELECTCOLUMNS(
				    FILTER(
				        ComplianceTrackingTable,
				        ComplianceTrackingTable[Statut lecture] IN {"En retard", "Paiement en attente", "Urgent"}
				    ),
				    "Suivi_ID", ComplianceTrackingTable[Suivi_ID],
				    "Organisme", LOOKUPVALUE(ComplianceObligationTable[Organisme], ComplianceObligationTable[Obligation_ID], ComplianceTrackingTable[Obligation_ID]),
				    "Obligation", LOOKUPVALUE(ComplianceObligationTable[Obligation], ComplianceObligationTable[Obligation_ID], ComplianceTrackingTable[Obligation_ID]),
				    "Statut", ComplianceTrackingTable[Statut lecture],
				    "Échéance", ComplianceTrackingTable[Date_Échéance],
				    "Jours restants", ComplianceTrackingTable[Jours restants lecture],
				    "Action", ComplianceTrackingTable[Action lecture],
				    "Responsable", ComplianceTrackingTable[Responsable_Client],
				    "Montant dû", ComplianceTrackingTable[Montant_Dû],
				    "Montant payé", ComplianceTrackingTable[Montant_Payé],
				    "Reste à payer", ComplianceTrackingTable[Reste paiement lecture]
				)
