table ComplianceDetailPrepare
	lineageTag: 20999999-9999-4999-8999-999999999000

	column 'Suivi_ID'
		dataType: string
		lineageTag: 20999999-9999-4999-8999-999999999001
		summarizeBy: none
		isNameInferred
		sourceColumn: [Suivi_ID]

	column 'Organisme'
		dataType: string
		lineageTag: 20999999-9999-4999-8999-999999999002
		summarizeBy: none
		isNameInferred
		sourceColumn: [Organisme]

	column 'Obligation'
		dataType: string
		lineageTag: 20999999-9999-4999-8999-999999999003
		summarizeBy: none
		isNameInferred
		sourceColumn: [Obligation]

	column 'Statut'
		dataType: string
		lineageTag: 20999999-9999-4999-8999-999999999004
		summarizeBy: none
		isNameInferred
		sourceColumn: [Statut]

	column 'Échéance'
		dataType: dateTime
		formatString: Short Date
		lineageTag: 20999999-9999-4999-8999-999999999005
		summarizeBy: none
		isNameInferred
		sourceColumn: [Échéance]

	column 'Jours restants'
		dataType: int64
		formatString: 0
		lineageTag: 20999999-9999-4999-8999-999999999006
		summarizeBy: none
		isNameInferred
		sourceColumn: [Jours restants]

	column 'Action'
		dataType: string
		lineageTag: 20999999-9999-4999-8999-999999999007
		summarizeBy: none
		isNameInferred
		sourceColumn: [Action]

	column 'Responsable'
		dataType: string
		lineageTag: 20999999-9999-4999-8999-999999999008
		summarizeBy: none
		isNameInferred
		sourceColumn: [Responsable]

	partition ComplianceDetailPrepare = calculated
		mode: import
		source =
				SELECTCOLUMNS(
				    FILTER(
				        ComplianceTrackingTable,
				        ComplianceTrackingTable[Statut lecture] = "À préparer"
				    ),
				    "Suivi_ID", ComplianceTrackingTable[Suivi_ID],
				    "Organisme", LOOKUPVALUE(ComplianceObligationTable[Organisme], ComplianceObligationTable[Obligation_ID], ComplianceTrackingTable[Obligation_ID]),
				    "Obligation", LOOKUPVALUE(ComplianceObligationTable[Obligation], ComplianceObligationTable[Obligation_ID], ComplianceTrackingTable[Obligation_ID]),
				    "Statut", ComplianceTrackingTable[Statut lecture],
				    "Échéance", ComplianceTrackingTable[Date_Échéance],
				    "Jours restants", ComplianceTrackingTable[Jours restants lecture],
				    "Action", ComplianceTrackingTable[Action lecture],
				    "Responsable", ComplianceTrackingTable[Responsable_Client]
				)
