table ComplianceDetailPayments
	lineageTag: 20555555-5555-4555-8555-555555555000

	column 'Suivi_ID'
		dataType: string
		lineageTag: 20555555-5555-4555-8555-555555555001
		summarizeBy: none
		isNameInferred
		sourceColumn: [Suivi_ID]

	column 'Organisme'
		dataType: string
		lineageTag: 20555555-5555-4555-8555-555555555002
		summarizeBy: none
		isNameInferred
		sourceColumn: [Organisme]

	column 'Obligation'
		dataType: string
		lineageTag: 20555555-5555-4555-8555-555555555003
		summarizeBy: none
		isNameInferred
		sourceColumn: [Obligation]

	column 'Statut'
		dataType: string
		lineageTag: 20555555-5555-4555-8555-555555555004
		summarizeBy: none
		isNameInferred
		sourceColumn: [Statut]

	column 'Échéance'
		dataType: dateTime
		formatString: Short Date
		lineageTag: 20555555-5555-4555-8555-555555555005
		summarizeBy: none
		isNameInferred
		sourceColumn: [Échéance]

	column 'Jours restants'
		dataType: int64
		formatString: 0
		lineageTag: 20555555-5555-4555-8555-555555555006
		summarizeBy: none
		isNameInferred
