	column 'Action'
		dataType: string
		lineageTag: 20555555-5555-4555-8555-555555555007
		summarizeBy: none
		isNameInferred
		sourceColumn: [Action]

	column 'Responsable'
		dataType: string
		lineageTag: 20555555-5555-4555-8555-555555555008
		summarizeBy: none
		isNameInferred
		sourceColumn: [Responsable]

	column 'Montant dû'
		dataType: int64
		formatString: #,0
		lineageTag: 20555555-5555-4555-8555-555555555009
		summarizeBy: none
		isNameInferred
		sourceColumn: [Montant dû]

	column 'Montant payé'
		dataType: int64
		formatString: #,0
		lineageTag: 20555555-5555-4555-8555-555555555010
		summarizeBy: none
		isNameInferred
		sourceColumn: [Montant payé]

	column 'Reste à payer'
		dataType: int64
		formatString: #,0
		lineageTag: 20555555-5555-4555-8555-555555555011
		summarizeBy: none
		isNameInferred
		sourceColumn: [Reste à payer]

	partition ComplianceDetailPayments = calculated
		mode: import
		source =
				SELECTCOLUMNS(
				    FILTER(
				        ComplianceTrackingTable,
				        ComplianceTrackingTable[Reste paiement lecture] > 0
				    ),
				    "Suivi_ID", ComplianceTrackingTable[Suivi_ID],
				    "Organisme", LOOKUPVALUE(ComplianceObligationTable[Organisme], ComplianceObligationTable[Obligation_ID], ComplianceTrackingTable[Obligation_ID]),
				    "Obligation", LOOKUPVALUE(ComplianceObligationTable[Obligation], ComplianceObligationTable[Obligation_ID], ComplianceTrackingTable[Obligation_ID]),
				    "Statut", ComplianceTrackingTable[Statut lecture],
				    "Échéance", ComplianceTrackingTable[Date_Échéance],
				    "Jours restants", ComplianceTrackingTable[Jours restants lecture],
				    "Action", ComplianceTrackingTable[Action lecture],
				    "Responsable", ComplianceTrackingTable[Responsable_Client],
				    "Montant dû", ComplianceTrackingTable[Montant_Dû],
				    "Montant payé", ComplianceTrackingTable[Montant_Payé],
				    "Reste à payer", ComplianceTrackingTable[Reste paiement lecture]
				)
